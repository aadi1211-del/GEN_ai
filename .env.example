# ============================
# NeuraForge - Environment Config
# Copy this file to ".env" and fill in your real values.
# NEVER commit your real .env file to GitHub.
# ============================

# --- Flask ---
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-string
JWT_SECRET_KEY=change-this-to-another-long-random-string

# --- Database ---
# For quick local demo (no MySQL server needed) - default, works out of the box:
DATABASE_URL=sqlite:///neuraforge.db
# For MySQL (recommended for the final submission / viva):
# DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/neuraforge

# --- Generative AI Provider ---
# Choose "gemini" or "openai"
AI_PROVIDER=gemini

# Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# --- RAG / ChromaDB ---
CHROMA_PERSIST_DIR=app/chroma_db
UPLOAD_FOLDER=app/uploads
MAX_CONTENT_LENGTH_MB=15